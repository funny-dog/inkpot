{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "dom"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "mvp/**/*.ts",
    "mvp/**/*.mts",
    "test/**/*.ts"
  ]
}
