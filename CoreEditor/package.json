{
  "name": "inkpot-editor",
  "version": "1.0.0",
  "description": "Inkpot 的 Markdown 编辑器与离线渲染资源",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "jest",
    "render-assets": "node scripts/build-render-assets.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "build": "yarn lint && yarn typecheck && vite build --config editor/vite.config.mts && yarn render-assets"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/legacy-modes": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/jest": "^29.5.4",
    "@types/katex": "^0.16.8",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "resolutions": {
    "js-yaml": "^4.3.1",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4"
  },
  "browserslist": [
    "safari >= 18",
    "chrome >= 120"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.18.0"
}
