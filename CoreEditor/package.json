  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/jest": "^29.5.4",
    "@types/katex": "^0.16.8",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-promise": "^7.2.1",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.38.0",
    "ts-gyb": "^0.12.0",
