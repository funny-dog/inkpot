<Application x:Class="Inkpot.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
    </ResourceDictionary.MergedDictionaries>
    <!-- 与 macOS 一致的强调色：浅色墨蓝 #2b5a8c，深色 #7cb0e8；高对比度沿用 Default（深色）取值。 -->
    <ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary x:Key="Light">
        <SolidColorBrush x:Key="InkpotAccentBrush" Color="#FF2B5A8C" />
        <SolidColorBrush x:Key="InkpotSelectionBrush" Color="#1F2B5A8C" />
        <SolidColorBrush x:Key="InkpotSegmentTrackBrush" Color="#0F000000" />
      </ResourceDictionary>
      <ResourceDictionary x:Key="Default">
        <SolidColorBrush x:Key="InkpotAccentBrush" Color="#FF7CB0E8" />
        <SolidColorBrush x:Key="InkpotSelectionBrush" Color="#297CB0E8" />
        <SolidColorBrush x:Key="InkpotSegmentTrackBrush" Color="#12FFFFFF" />
      </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 顶栏图标按钮：无边框，选中时只换成强调色前景与浅底。 -->
    <Style x:Key="InkpotToolbarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- 侧栏文件、大纲和搜索的分段按钮，对应 macOS 侧栏顶部的滑块。 -->
    <Style x:Key="InkpotSegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- 侧栏空状态与设置页的次要说明文字。 -->
    <Style x:Key="InkpotSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 设置页分组卡片，跟随对话框自身的明暗主题。 -->
    <Style x:Key="InkpotSettingsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,4" />
    </Style>

    <Style x:Key="InkpotSettingsDividerStyle" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
  </ResourceDictionary></Application.Resources>
</Application>
