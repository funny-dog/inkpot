<Window x:Class="Inkpot.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <MenuBar x:Name="Menus" />
  <!-- TabView 默认 VerticalAlignment=Top，会随零固有高度的 WebView2 塌缩成标签条，必须显式拉伸填充。 -->
  <TabView x:Name="Tabs" Grid.Row="1" VerticalAlignment="Stretch" IsAddTabButtonVisible="True"
    AddTabButtonClick="AddTab" TabCloseRequested="CloseTab" SelectionChanged="SelectTab" />
  </Grid>
</Window>
